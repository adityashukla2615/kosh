# Which brain the advisor uses: auto | anthropic | bedrock | offline
# auto = anthropic if ANTHROPIC_API_KEY is set, bedrock if AWS_REGION + USE_BEDROCK=1, otherwise offline
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
KOSH_MODEL=claude-opus-5

USE_BEDROCK=0
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Leave empty locally -> in-memory store. Set in Lambda -> DynamoDB.
TABLE_NAME=

PORT=8787
